---
/**
 * A persistent Paper Grain Gradient with a slow, resolution-capped drift.
 * It loads during idle time and draws at about 30 times a second. Hidden tabs
 * and reduced-motion users retain a still frame instead of running the loop.
 */
---

<div
  class="grain-background-surface"
  aria-hidden="true"
  transition:persist="grain-background"
>
  <grain-background></grain-background>
</div>

<style>
  /* Keep the document-height scroll-linked layer out of normal flow. The
     body owns the containing block; clipping the surface prevents the
     counter-scrolling canvas from contributing a second scroll range. */
  .grain-background-surface {
    display: block;
    position: absolute;
    inset: 0;
    overflow: clip;
    /* Permit paint into the obscured browser insets without making the
       counter-scrolling child enlarge the document's scrollable bounds. */
    overflow-clip-margin: 128px;
    view-transition-name: none !important;
    pointer-events: none;
    z-index: 0;
  }

  grain-background {
    /* Preserve the live element, but capture it with the page's root snapshot.
       Astro's separate named snapshot would cover the content during a swap.
       Override its generated scope rule without disabling DOM persistence. */
    view-transition-name: none !important;
    display: block;
    /* Non-supporting browsers retain the original viewport-fixed fallback.
       The scroll-linked rule below switches this to document coordinates only
       after the runtime has confirmed that the browser can animate on the
       root scroll timeline. */
    position: fixed;
    /* Use the largest viewport so Safari's collapsing toolbar does not resize
       the shader and shift its projection while scrolling. Overscan the top
       cutout as well; avoid safe-area-inset-bottom here because it can change
       with the toolbar. Chrome may still use a solid colour extension. */
    top: calc(-1 * env(safe-area-inset-top, 0px));
    left: 0;
    right: 0;
    height: calc(100vh + env(safe-area-inset-top, 0px));
    height: calc(100lvh + env(safe-area-inset-top, 0px));
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    /* Also visible before the module loads, with JS disabled, or without WebGL. */
    background: radial-gradient(ellipse at 0% 0%, #382237, transparent 70%),
      radial-gradient(ellipse at 100% 100%, #493124, transparent 70%), #100e16;
  }

  :global([data-theme="light"]) grain-background {
    background: radial-gradient(ellipse at 0% 0%, #e8dce9, transparent 70%),
      radial-gradient(ellipse at 100% 100%, #f0d8bd, transparent 70%), #faf7f2;
  }

  /* A scroll-driven transform keeps the stable large-viewport canvas aligned
     with the visual viewport as the document scrolls. CSS owns this transform
     on the compositor; the WebGL loop below continues to spend the same draw
     budget as the fixed fallback. */
  @supports (animation-timeline: scroll(root block)) {
    .grain-background-surface[data-scroll-linked] grain-background {
      position: absolute;
      /* Safari's obscured controls are not represented consistently by safe-area
         variables. A stable paint buffer covers expanded and compact bottom
         bars. iOS 27 still paints its own top inset at the scroll origin. */
      top: -128px;
      height: calc(100lvh + 256px);
      animation-name: grain-background-counter-scroll;
      animation-duration: 1ms;
      animation-timing-function: linear;
      animation-iteration-count: 1;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
      animation-range: 0% 100%;
    }
  }

  @keyframes grain-background-counter-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(0, var(--grain-scroll-range, 0px), 0); }
  }

  /* The global reduced-motion rule shortens every animation. Counter-scrolling
     is positional rather than decorative, so retain it for an accessible
     still shader while disabling only the separate WebGL drift loop in JS. */
  @media (prefers-reduced-motion: reduce) {
    .grain-background-surface[data-scroll-linked] grain-background {
      animation-duration: auto !important;
      animation-iteration-count: 1 !important;
      animation-play-state: running !important;
    }
  }

  /* Paper injects its default canvas CSS into <head>, which Astro replaces on
     navigation. Own the sizing here so a persisted, resolution-capped canvas
     continues covering the viewport after a page swap or resize. */
  grain-background :global(canvas) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    z-index: 0;
    contain: strict;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  grain-background :global(canvas[data-grain-ready]) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    grain-background :global(canvas) { transition: none; }
  }

  @media print {
    grain-background { display: none; }
  }
</style>

<script>
  import type { ShaderMount } from "@paper-design/shaders";

  class GrainBackground extends HTMLElement {
    private mount?: ShaderMount;
    private observer?: MutationObserver;
    private initializing = false;
    private idle?: number;
    private timer?: ReturnType<typeof setTimeout>;
    private revealObserver?: ResizeObserver;
    private revealFrame?: number;
    private motionFrame?: number;
    private motionListeners?: AbortController;
    private reducedMotion?: MediaQueryList;
    private scrollSurface?: HTMLElement;
    private scrollRangeObserver?: ResizeObserver;
    private scrollRangeFrame?: number;
    private scrollRangeResize?: () => void;

    private updateScrollRange = () => {
      this.scrollRangeFrame = undefined;
      const surface = this.scrollSurface;
      if (!surface || !this.isConnected) return;

      const root = document.scrollingElement ?? document.documentElement;
      const range = Math.max(0, root.scrollHeight - root.clientHeight);
      this.style.setProperty("--grain-scroll-range", `${range}px`);
    };

    private scheduleScrollRangeUpdate = () => {
      if (this.scrollRangeFrame !== undefined) return;
      this.scrollRangeFrame = requestAnimationFrame(this.updateScrollRange);
    };

    private disconnectScrollLink() {
      if (this.scrollRangeFrame !== undefined) cancelAnimationFrame(this.scrollRangeFrame);
      this.scrollRangeFrame = undefined;
      this.scrollRangeObserver?.disconnect();
      this.scrollRangeObserver = undefined;
      if (this.scrollRangeResize) {
        window.removeEventListener("resize", this.scrollRangeResize);
        this.scrollRangeResize = undefined;
      }
      this.scrollSurface?.removeAttribute("data-scroll-linked");
      this.scrollSurface = undefined;
      this.style.removeProperty("--grain-scroll-range");
    }

    private connectScrollLink() {
      const surface = this.parentElement;
      if (!(surface instanceof HTMLElement)) return;
      if (this.scrollSurface === surface && this.scrollRangeObserver) {
        this.scheduleScrollRangeUpdate();
        return;
      }

      this.disconnectScrollLink();
      this.scrollSurface = surface;

      // Keep the fixed fallback on browsers without a root scroll timeline.
      // The attribute is deliberately runtime-owned so CSS cannot put a
      // document-coordinate layer on a browser that cannot counter-scroll it.
      const supportsScrollTimeline = typeof CSS !== "undefined" &&
        CSS.supports("animation-timeline", "scroll(root block)");
      // This workaround is for Safari's obscured iOS browser controls. Safari
      // 26.4 introduced threaded scroll animations; earlier versions would add
      // main-thread work during scrolling. Keep the original fixed path on
      // desktop and unverified browser engines rather than changing them too.
      const safariVersion = navigator.userAgent.match(/Version\/(\d+)\.(\d+)/);
      const major = Number(safariVersion?.[1] ?? 0);
      const minor = Number(safariVersion?.[2] ?? 0);
      const threadedSafari = major > 26 || (major === 26 && minor >= 4);
      const touchWebKit = CSS.supports("-webkit-touch-callout", "none");
      if (!supportsScrollTimeline || !touchWebKit || !threadedSafari) return;

      surface.setAttribute("data-scroll-linked", "");
      const body = document.body;
      if (!body) return;

      this.scrollRangeObserver = new ResizeObserver(this.scheduleScrollRangeUpdate);
      this.scrollRangeObserver.observe(body);
      this.scrollRangeResize = this.scheduleScrollRangeUpdate;
      window.addEventListener("resize", this.scrollRangeResize, { passive: true });
      this.updateScrollRange();
    }

    private stopMotion() {
      if (this.motionFrame !== undefined) cancelAnimationFrame(this.motionFrame);
      this.motionFrame = undefined;
    }

    private syncMotion = () => {
      this.stopMotion();
      const mounted = this.mount;
      if (!mounted || !this.isConnected || document.hidden || this.reducedMotion?.matches ||
          !mounted.canvasElement.hasAttribute("data-grain-ready")) return;

      // Paper's native speed loop renders at the display's refresh rate. Keep
      // that loop stopped and advance its millisecond frame clock ourselves:
      // slow decorative drift needs only 30 draws/sec, even on a 120Hz display.
      // Restart the elapsed-time clock on resume so hidden time never jumps.
      let lastDraw = performance.now();
      const tick = (now: number) => {
        this.motionFrame = undefined;
        if (this.mount !== mounted || !this.isConnected || document.hidden || this.reducedMotion?.matches) return;
        const elapsed = now - lastDraw;
        // Allow sub-millisecond display-clock jitter so two 60Hz ticks do not
        // accidentally miss the threshold and reduce the cadence to 20fps.
        if (elapsed >= 1000 / 30 - 1) {
          // Half Paper's standard speed: the corners drift over ~24–42 seconds
          // instead of the imperceptible multi-minute cycles at 0.08 speed.
          mounted.setFrame(mounted.getCurrentFrame() + Math.min(elapsed, 100) * 0.5);
          lastDraw = now;
        }
        this.motionFrame = requestAnimationFrame(tick);
      };
      this.motionFrame = requestAnimationFrame(tick);
    };

    private cancelReveal() {
      this.revealObserver?.disconnect();
      this.revealObserver = undefined;
      if (this.revealFrame !== undefined) cancelAnimationFrame(this.revealFrame);
      this.revealFrame = undefined;
    }

    connectedCallback() {
      // Astro can reconnect the persistent subtree during a navigation. Rebind
      // the body observer to the current document before checking the shader
      // mount so positional counter-scrolling is restored independently of
      // decorative motion state.
      this.connectScrollLink();

      // A persisted element may reconnect after a tick observed its temporary
      // removal. Restart from the retained frame instead of remaining frozen.
      if (this.mount) { this.syncMotion(); return; }
      if (this.initializing || this.idle !== undefined || this.timer !== undefined) return;
      const start = () => {
        this.idle = undefined;
        this.timer = undefined;
        void this.initialize();
      };
      // Keep shader download/compilation off the initial synchronous page path.
      if ("requestIdleCallback" in window) {
        this.idle = window.requestIdleCallback(start, { timeout: 1500 });
      } else {
        this.timer = setTimeout(start, 250);
      }
    }

    private async initialize() {
      if (!this.isConnected || this.mount || this.initializing) return;
      this.initializing = true;
      try {
        const { ShaderMount, grainGradientFragmentShader, GrainGradientShapes,
          getShaderColorFromString, getShaderNoiseTexture } = await import("../scripts/grain-shader");
        const noise = getShaderNoiseTexture();
        if (noise) await noise.decode();
        if (!this.isConnected) return;

        const palette = () => {
          const light = document.documentElement.dataset.theme === "light";
          return {
            u_colorBack: getShaderColorFromString(light ? "#faf7f2" : "#100e16"),
            u_colors: (light
              ? ["#e5d4e9", "#efd3af", "#f7e8dd"]
              : ["#51334f", "#795035", "#29253f"]
            ).map(getShaderColorFromString),
          };
        };

        this.mount = new ShaderMount(this, grainGradientFragmentShader, {
          ...palette(), u_colorsCount: 3, u_softness: 0.85, u_intensity: 0.2,
          u_noise: 0.08, u_shape: GrainGradientShapes.corners,
          ...(noise ? { u_noiseTexture: noise } : {}),
          // Contain keeps the coloured corners visible on narrow phone screens.
          u_fit: 1, u_scale: 1, u_rotation: 0, u_offsetX: 0, u_offsetY: 0,
          u_originX: 0.5, u_originY: 0.5, u_worldWidth: 0, u_worldHeight: 0,
        }, {
          alpha: false,
          antialias: false,
          powerPreference: "low-power",
          // A speed of zero renders only on setup, resize, or uniform changes.
          // Retain that frame when Astro reparents the persistent canvas or the
          // browser rebuilds its compositor layers; the WebGL default permits
          // discarding the drawing buffer after it has been presented.
          preserveDrawingBuffer: true,
        },
        // speed=0 stops Paper's uncapped loop; syncMotion owns the draw budget.
        // Cap the backing canvas at ~1MP instead of the library's 4K default.
        0, 12000, 1, 1_048_576);

        // Mobile GPU pressure can evict a context after successful startup.
        // Remove the opaque canvas so the fallback remains visible; do not
        // repeatedly allocate new contexts while the device is under pressure.
        this.mount.canvasElement.addEventListener("webglcontextlost", () => {
          this.cancelReveal();
          this.stopMotion();
          this.motionListeners?.abort();
          this.observer?.disconnect();
          this.mount?.dispose();
          this.mount = undefined;
          this.querySelector("canvas")?.remove();
        }, { once: true });

        // The mount inserts an opaque canvas before its ResizeObserver performs
        // the first correctly sized draw. Keep that canvas transparent until a
        // non-zero layout exists, then redraw once immediately before revealing
        // it. This makes the late idle-loaded shader replace its CSS fallback
        // smoothly without exposing the canvas's initial drawing buffer.
        const mounted = this.mount;
        const canvas = mounted.canvasElement;
        this.revealObserver = new ResizeObserver(() => {
          const bounds = this.getBoundingClientRect();
          if (bounds.width === 0 || bounds.height === 0) return;

          this.revealObserver?.disconnect();
          this.revealObserver = undefined;
          this.revealFrame = requestAnimationFrame(() => {
            this.revealFrame = undefined;
            if (!this.isConnected || this.mount !== mounted) return;
            mounted.setFrame(mounted.getCurrentFrame());
            canvas.dataset.grainReady = "";
            this.syncMotion();
          });
        });
        this.revealObserver.observe(this);

        this.reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        this.motionListeners = new AbortController();
        const signal = this.motionListeners.signal;
        document.addEventListener("visibilitychange", this.syncMotion, { signal });
        this.reducedMotion.addEventListener("change", this.syncMotion, { signal });

        this.observer = new MutationObserver(() => this.mount?.setUniforms(palette()));
        this.observer.observe(document.documentElement, {
          attributes: true, attributeFilter: ["data-theme"],
        });
      } catch (error) {
        this.cancelReveal();
        this.stopMotion();
        this.motionListeners?.abort();
        this.mount?.dispose();
        this.mount = undefined;
        this.querySelector("canvas")?.remove();
        console.warn("Grain background unavailable; using CSS fallback.", error);
      } finally {
        this.initializing = false;
      }
    }

    disconnectedCallback() {
      // Astro briefly moves persisted elements while swapping pages. Only tear
      // down when truly removed, avoiding a new WebGL context per navigation.
      queueMicrotask(() => {
        if (this.isConnected) return;
        if (this.idle !== undefined) window.cancelIdleCallback(this.idle);
        if (this.timer !== undefined) clearTimeout(this.timer);
        this.idle = undefined;
        this.timer = undefined;
        this.cancelReveal();
        this.stopMotion();
        this.motionListeners?.abort();
        this.disconnectScrollLink();
        this.observer?.disconnect();
        this.mount?.dispose();
        this.mount = undefined;
      });
    }
  }

  if (!customElements.get("grain-background")) {
    customElements.define("grain-background", GrainBackground);
  }

  // Custom element constructors cannot be replaced. Reload on script updates
  // during development so palette/lifecycle edits do not retain an old class.
  if (import.meta.hot) {
    import.meta.hot.accept(() => import.meta.hot?.invalidate());
  }
</script>

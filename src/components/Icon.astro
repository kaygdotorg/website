// Icons that use fill instead of stroke
const fillIcons: ReadonlySet<IconName> = new Set([
    "github",
    "x",
    "twitter",
    "linkedin",
    "mastodon",
    "telegram",
]);
const isFillIcon = fillIcons.has(name);
---

<svg
    id={id}
    class={className}
    fill={isFillIcon ? "currentColor" : "none"}
    viewBox="0 0 24 24"
    stroke={isFillIcon ? "none" : "currentColor"}
    stroke-width={isFillIcon ? undefined : strokeWidth}
    aria-hidden="true"
    set:html={icons[name]}
/>

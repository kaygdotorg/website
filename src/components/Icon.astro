type IconName =
    | "sun"
    | "moon"
    | "search"
    | "arrow"
    | "hamburger"
    | "close"
    | "github"
    | "twitter"
    | "x"
    | "linkedin"
    | "email"
    | "arrow-down"
    | "arrow-up"
    | "download"
    | "home"
    | "link"
    | "mastodon"
    | "telegram";

interface Props {
    name: IconName;
    class?: string;
    strokeWidth?: number;
    id?: string;
}


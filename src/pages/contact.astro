---
/**
 * =============================================================================
 * LEGACY CONTACT PAGE REDIRECT (/contact)
 * =============================================================================
 *
 * Contact details now live on the About page so the site has a single profile
 * destination instead of splitting bio and reachability across two thin pages.
 *
 * Keep /contact alive as a static redirect to the stable #contact heading on
 * /about. The page is intentionally tiny so it works when dist/ is served as a
 * plain static directory.
 */
const destination = "/about#contact";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to /about#contact</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={destination} />
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
  </head>
  <body>
    <p>Redirecting to <a href={destination}>{destination}</a>.</p>
    <script is:inline>
      window.location.replace("/about#contact");
    </script>
  </body>
</html>
